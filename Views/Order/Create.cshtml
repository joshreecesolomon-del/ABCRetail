@model ABCRetail.Models.OrderModel

@{
    ViewData["Title"] = "Process Order";
}

<h2>Process Order</h2>

@if (ViewBag.Message != null)
{
    <div class="alert alert-success">
        @ViewBag.Message
    </div>
}

<form asp-action="Create" method="post">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="OrderId" class="form-label">
            Order ID
        </label>

        <input asp-for="OrderId"
               class="form-control"
               placeholder="e.g. ORD-1001" />

        <span asp-validation-for="OrderId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CustomerName" class="form-label">
            Customer Name
        </label>

        <input asp-for="CustomerName"
               class="form-control"
               placeholder="e.g. John Smith" />

        <span asp-validation-for="CustomerName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProductName" class="form-label">
            Product
        </label>

        <input asp-for="ProductName"
               class="form-control"
               placeholder="e.g. Samsung Galaxy S25" />

        <span asp-validation-for="ProductName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label">
            Quantity
        </label>

        <input asp-for="Quantity"
               type="number"
               min="1"
               class="form-control" />

        <span asp-validation-for="Quantity"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Process Order
    </button>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}